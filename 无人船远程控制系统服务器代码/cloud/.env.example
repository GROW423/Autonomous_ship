# ============================================================
# 无人船云平台环境变量配置
# 复制为 .env 并修改实际值: cp .env.example .env
# ============================================================

# PostgreSQL
POSTGRES_USER=usv
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=usv
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MediaMTX (视频SFU)
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997
# 云服务器公网IP或域名, 用于WebRTC ICE候选
MEDIAMTX_PUBLIC_IP=your-server-ip-or-domain
# 前端访问WebRTC的完整URL
MEDIAMTX_WEBRTC_URL=http://your-server-ip-or-domain:8889

# MAVLink Gateway
MAVLINK_TCP_PORT=5760

# API Server
API_PORT=8000
# JWT密钥, 生产环境必须修改为随机字符串
SECRET_KEY=please_change_this_to_a_long_random_string_at_least_32_chars
# Token有效期 (分钟), 默认24小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# CORS允许的来源, 生产环境指定前端域名, 多个用逗号分隔
CORS_ORIGINS=*
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
