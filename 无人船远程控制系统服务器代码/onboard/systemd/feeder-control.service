[Unit]
Description=USV Feeder Motor Controller
After=mavlink-router.service
Requires=mavlink-router.service

[Service]
Type=simple
ExecStart=/opt/usv/venv/bin/python /opt/usv/services/feeder_control.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=feeder-control
# GPIO访问需要root, 或加入gpio组
User=root

[Install]
WantedBy=multi-user.target
