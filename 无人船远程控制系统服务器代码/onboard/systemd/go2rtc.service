[Unit]
Description=go2rtc Video Streaming Server
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/go2rtc -config /opt/usv/config/go2rtc.yaml
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=go2rtc

[Install]
WantedBy=multi-user.target
